<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.toufiqul.studentmanagement.StudentController">
   <children>
      <Label layoutX="68.0" layoutY="49.0" text="Student id" />
      <TextField fx:id="IdTExtField" layoutX="59.0" layoutY="93.0" />
      <TextField fx:id="nameTextField" layoutX="59.0" layoutY="175.0" />
      <TextField fx:id="cgpaTextfield" layoutX="68.0" layoutY="255.0" />
      <Label layoutX="68.0" layoutY="143.0" text="Student Name" />
      <Label layoutX="68.0" layoutY="220.0" text="CGPA" />
      <TableView fx:id="studentTable" layoutX="354.0" layoutY="88.0" prefHeight="200.0" prefWidth="223.0">
        <columns>
          <TableColumn fx:id="idColum" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="nameColum" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="cgpaColum" prefWidth="75.0" text="CGPA" />
        </columns>
      </TableView>
      <Button fx:id="button" layoutX="248.0" layoutY="304.0" mnemonicParsing="false" onAction="#saveButtonClick" text="Save" />
