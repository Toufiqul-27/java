<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tigerit.registrationsystem.RegistrationController">
   <children>
      <TextField fx:id="nameTextField" layoutX="64.0" layoutY="166.0" />
      <Label layoutX="205.0" layoutY="26.0" text="Registration">
         <font>
            <Font name="System Bold" size="33.0" />
         </font>
      </Label>
      <Label layoutX="64.0" layoutY="131.0" text="User name:">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <PasswordField fx:id="passwordField" layoutX="64.0" layoutY="305.0" />
      <Label layoutX="68.0" layoutY="274.0" text="Password:">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <TextField fx:id="emailTextField" layoutX="64.0" layoutY="235.0" />
      <Label layoutX="68.0" layoutY="210.0" text="Email :">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Button layoutX="276.0" layoutY="338.0" mnemonicParsing="false" onAction="#saveButtonClickEvent" text="Save">
         <font>
            <Font size="19.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
