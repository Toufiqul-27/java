<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="15.0" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrolinkbd.agrolinkbd.OrderController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#goBack" text="← Back"
                        styleClass="secondary-button" />
                <Label text="Order Management" styleClass="header-label"
                       HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="filterStatusCombo" promptText="Filter by Status" prefWidth="160.0" />
                <Button mnemonicParsing="false" onAction="#handleLogout" text="Logout"
                        styleClass="secondary-button" />
            </children>
        </HBox>

        <HBox spacing="15.0">
            <children>
                <VBox styleClass="card" spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Total Orders" style="-fx-font-size: 12px; -fx-text-fill: #666;" />
                        <Label fx:id="totalOrdersLabel" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold;" />
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
                <VBox styleClass="card" spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Pending" style="-fx-font-size: 12px; -fx-text-fill: #666;" />
                        <Label fx:id="pendingOrdersLabel" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f39c12;" />
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
                <VBox styleClass="card" spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Confirmed" style="-fx-font-size: 12px; -fx-text-fill: #666;" />
                        <Label fx:id="confirmedOrdersLabel" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
                <VBox styleClass="card" spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Dispatched" style="-fx-font-size: 12px; -fx-text-fill: #666;" />
                        <Label fx:id="dispatchedOrdersLabel" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2980b9;" />
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
            </children>
        </HBox>

        <Label text="Orders List:" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colOrderId" prefWidth="80.0" text="Order ID" />
                <TableColumn fx:id="colCropName" prefWidth="150.0" text="Crop Name" />
                <TableColumn fx:id="colBuyerName" prefWidth="130.0" text="Buyer" />
                <TableColumn fx:id="colQuantity" prefWidth="100.0" text="Qty (KG)" />
                <TableColumn fx:id="colTotalPrice" prefWidth="120.0" text="Total (BDT)" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="colOrderDate" prefWidth="120.0" text="Date" />
            </columns>
        </TableView>

        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <children>
                <Label text="Update Selected:" style="-fx-font-weight: bold;" />
                <Button mnemonicParsing="false" onAction="#handleConfirmOrder" text="✓ Confirm"
                        styleClass="primary-button" />
                <Button mnemonicParsing="false" onAction="#handleDispatchOrder" text="🚛 Dispatch"
                        styleClass="secondary-button" />
                <Button mnemonicParsing="false" onAction="#handleCancelOrder" text="✗ Cancel"
                        styleClass="danger-button" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>